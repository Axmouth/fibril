---
import BrandMascot from "./BrandMascot.astro";
// Preserve Starlight's localized/version-aware home link and title.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="site-title">
  <BrandMascot />
  <span translate="no">{siteTitle}</span>
</a>
<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    min-width: 0;
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
  }
</style>
