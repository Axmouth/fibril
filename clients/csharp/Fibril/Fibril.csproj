<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target the prior LTS so net8/net9/net10 apps can all reference the client.
         Every API used (Channels, IAsyncEnumerable, Span, nullable) is in net8.0,
         so no polyfill packages are needed. The test project targets the locally
         installed runtime (net10.0) and references this net8.0 library fine. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Fibril</RootNamespace>
    <AssemblyName>Fibril</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML doc comments are not an error while the surface is in flux. -->
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata. Version is bumped by scripts/release.sh. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Fibril</PackageId>
    <Version>0.4.0</Version>
    <Authors>Axmouth</Authors>
    <Description>.NET client for the Fibril message broker.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://fibril.sh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Axmouth/fibril</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fibril;message-broker;message-queue;pubsub;client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- README and AI policy have one copy each in the repo, packed from there. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\..\AI_POLICY.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
