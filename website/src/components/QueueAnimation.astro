---
interface Props {
  /** Set when a parent decides when the animation runs. */
  managed?: boolean;
}
const { managed = false } = Astro.props;
---
<div class="queue-visual" role="img" aria-label="Message queue lifecycle: a message is leased by a worker, then acknowledged or delayed before retrying" data-queue-visual data-managed={managed ? "" : undefined}>
  <div class="qv-stage">
    <div class="visual-grid"></div>
    <div class="queue-node">
      <span class="node-label">queue</span>
      <strong>email.send</strong>
    </div>
    <div class="worker-node">
      <span class="worker-led"></span>
      <span class="node-label">worker</span>
      <strong>leased</strong>
    </div>
    <div class="ack-node"><span class="ack-mark">✓</span><span>ack</span></div>
    <div class="retry-node"><span>delay 30s</span></div>
    <span class="flow-line line-to-worker"></span>
    <span class="flow-line line-to-ack"></span>
    <span class="flow-line line-to-retry"></span>
    <span class="flow-line line-back"></span>
    <span class="packet packet-main"></span>
    <span class="packet packet-ack"></span>
    <span class="packet packet-retry"></span>
  </div>
  <div class="visual-caption"><span>queue lifecycle</span><span>traffic: active</span></div>
</div>
<script>
  // Pause the CSS animation while the panel is scrolled out of view.
  // Hidden tabs already stop rendering, so only visibility in the page matters.
  for (const visual of document.querySelectorAll<HTMLElement>("[data-queue-visual]:not([data-managed])")) {
    if (!("IntersectionObserver" in window)) break;
    new IntersectionObserver(([entry]) => {
      visual.toggleAttribute("data-paused", !entry?.isIntersecting);
    }).observe(visual);
  }
</script>
