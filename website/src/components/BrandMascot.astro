---
import awake from "../../../crates/admin/admin-ui/img/sprites/ring-open-128.png";
import blink from "../../../crates/admin/admin-ui/img/sprites/ring-closed-128.png";
---
<span class="brand-mascot" aria-hidden="true">
  <img class="awake" src={awake.src} width={awake.width} height={awake.height} alt="" />
  <img class="blink" src={blink.src} width={blink.width} height={blink.height} alt="" />
</span>
<style>
  .brand-mascot {
    display: inline-grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    flex: 0 0 auto;
    width: 48px;
    height: 56px;
    place-items: center;
    position: relative;
    isolation: isolate;
  }
  .brand-mascot::before {
    content: "";
    position: absolute;
    pointer-events: none;
    inset: 2px 0;
    border-radius: 50%;
    border: 1px solid #b9e7ff99;
    background: #71c8ff18;
    box-shadow: 0 0 7px #7dcfff80, inset 0 0 9px #9bdcff66;
  }
  .brand-mascot img {
    position: relative;
    z-index: 1;
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
    image-rendering: pixelated;
  }
  :global([data-theme="light"]) .brand-mascot::before {
    border-color: #65bde477;
    background: #71c8ff12;
    box-shadow: 0 0 7px #7dcfff40, inset 0 0 9px #9bdcff33;
  }
  .blink { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .awake { animation: mascot-awake 8s step-end infinite; }
    .blink { animation: mascot-blink 8s step-end infinite; }
  }
  @keyframes mascot-awake { 0%, 97% { opacity: 1; } 95% { opacity: 0; } }
  @keyframes mascot-blink { 0%, 97% { opacity: 0; } 95% { opacity: 1; } }
</style>
