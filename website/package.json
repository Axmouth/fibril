{
  "name": "fibril-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run assets:build && npm run demo:build && astro dev",
    "build": "npm run assets:build && npm run demo:build && npm run demo:test && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "smoke:server": "node scripts/smoke-server.mjs",
    "verify": "npm run build && npm run smoke:dist",
    "demo:build": "node demo/build.mjs",
    "demo:test": "node demo/demo.test.mjs",
    "assets:build": "node scripts/build-branding.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.3",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.3",
    "starlight-versions": "^0.9.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3"
  }
}
