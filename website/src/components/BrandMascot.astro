---
import awake from "../../../crates/admin/admin-ui/img/sprites/ring-open-128.png";
import blink from "../../../crates/admin/admin-ui/img/sprites/ring-closed-128.png";
---
<span class="brand-mascot" aria-hidden="true">
  <img class="awake" src={awake.src} width={awake.width} height={awake.height} alt="" />
  <img class="blink" src={blink.src} width={blink.width} height={blink.height} alt="" />
</span>
<style>
  .brand-mascot {
    display: inline-grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    box-sizing: border-box;
    padding: 4px;
    place-items: center;
    border: 1px solid #bfd4de55;
    border-radius: 13px;
    background:
      radial-gradient(ellipse at 20% 0%, #b4ebe24d, transparent 70%),
      linear-gradient(145deg, #697584, #424e60 55%, #303b4b);
    box-shadow: inset 0 1px 0 #ffffff30, 0 2px 5px #00000020;
  }
  .brand-mascot img {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
    image-rendering: pixelated;
  }
  .blink { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .awake { animation: mascot-awake 8s step-end infinite; }
    .blink { animation: mascot-blink 8s step-end infinite; }
  }
  @keyframes mascot-awake { 0%, 97% { opacity: 1; } 95% { opacity: 0; } }
  @keyframes mascot-blink { 0%, 97% { opacity: 0; } 95% { opacity: 1; } }
</style>
