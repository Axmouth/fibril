---
interface Props {
  view?: 'overview' | 'queues' | 'queue' | 'streams' | 'topology' | 'settings';
  topic?: string;
  title: string;
  height?: number;
}
const { view = 'overview', topic, title, height = 640 } = Astro.props;
const path = view === 'overview' ? '/dashboard-demo/' : `/dashboard-demo/admin/${view}/`;
const src = topic ? `${path}?${new URLSearchParams({ topic })}` : path;
---
<figure class="dashboard-example">
  <figcaption>
    <span>{title} · read-only sample</span>
    <a href={src} target="_blank" rel="noopener">Open full dashboard ↗</a>
  </figcaption>
  <iframe src={src} title={title} loading="lazy" height={height}
    referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-popups allow-top-navigation-by-user-activation"></iframe>
</figure>
<style>
  .dashboard-example { margin: 1.5rem 0; border: 1px solid var(--sl-color-gray-5); border-radius: 8px; overflow: hidden; }
  figcaption { display: flex; flex-wrap: wrap; gap: .5rem 1rem; padding: .75rem; font-size: .85rem; }
  figcaption a { margin-inline-start: auto; }
  iframe { display: block; width: 100%; border: 0; margin: 0; background: #10151c; }
</style>
