---
import { Code } from "astro:components";
import { siteCodeTheme } from "../styles/code-theme";
import { Tabs, TabItem } from "@astrojs/starlight/components";
import rust from "../examples/workers/worker.rs.txt?raw";
import csharp from "../examples/workers/worker.cs.txt?raw";
import go from "../examples/workers/worker.go.txt?raw";
import typescript from "../examples/workers/worker.ts.txt?raw";
import python from "../examples/workers/worker.py.txt?raw";

const examples = [
  { label: "worker.rs (Rust)", lang: "rust", code: rust },
  { label: "worker.cs (C#)", lang: "csharp", code: csharp },
  { label: "worker.go (Go)", lang: "go", code: go },
  { label: "worker.ts (TypeScript)", lang: "typescript", code: typescript },
  { label: "worker.py (Python)", lang: "python", code: python },
] as const;
---

<section class="console worker-examples" aria-label="Worker examples by client language">
  <Tabs syncKey="worker-example">
    {examples.map(({ label, lang, code }) => (
      <TabItem label={label}>
        <Code code={code.trimEnd()} lang={lang} theme={siteCodeTheme} />
      </TabItem>
    ))}
  </Tabs>
  <div class="worker-footer">
    <span>complete · retry in 30s · fail</span>
    <a href="/clients/#manual-acknowledgements">Connection &amp; subscription setup →</a>
  </div>
  <p class="worker-context">
    Worker loops with manual acknowledgements. Email sending and error types are application code.
  </p>
</section>

<style>
  .worker-examples {
    --sl-outline-offset-inside: -4px;
    min-width: 0;
    background: var(--panel);
  }
  .worker-examples :global(.tablist-wrapper) {
    background: var(--bg-soft);
    scrollbar-width: thin;
    scrollbar-color: var(--line-2) var(--bg-soft);
  }
  .worker-examples :global([role="tablist"]) {
    margin: 0;
    border: 0;
    box-shadow: inset 0 -1px var(--line);
  }
  .worker-examples :global(.tab > [role="tab"]) {
    position: relative;
    padding: 11px 16px;
    border-top: 2px solid transparent;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    box-shadow: none;
    color: var(--muted);
    white-space: nowrap;
    font: 12px/1.5 var(--mono);
  }
  .worker-examples :global(.tab > [role="tab"]:hover) {
    background: var(--panel-2);
    color: var(--text);
  }
  .worker-examples :global(.tab > [role="tab"][aria-selected="true"]) {
    border-top-color: var(--accent);
    border-bottom-color: var(--panel);
    background: var(--panel);
    color: var(--text);
  }
  .worker-examples :global([role="tab"]:focus-visible) {
    outline: 2px solid var(--accent);
  }
  .worker-examples :global(.tablist-wrapper ~ [role="tabpanel"]) { margin-top: 0; }
  .worker-examples :global(pre) {
    padding: 16px 20px;
    font-size: 12px;
    line-height: 1.65;
    tab-size: 4;
  }
  .worker-footer {
    display: flex;
    justify-content: space-between;
    gap: 8px 20px;
    flex-wrap: wrap;
    padding: 10px 20px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font: 11px/1.5 var(--mono);
  }
  .worker-footer a { color: var(--accent); }
  .worker-footer a:hover { text-decoration: underline; }
  .worker-context {
    margin: 0;
    padding: 0 20px 12px;
    color: var(--muted);
    font-size: 12px;
  }
  @media (max-width: 600px) {
    .worker-examples :global(.tab > [role="tab"]) { padding: 11px 14px; }
    .worker-examples :global(pre) { padding: 14px 16px; }
    .worker-footer { padding-inline: 16px; }
    .worker-context { padding-inline: 16px; }
  }
</style>
