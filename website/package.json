{
  "name": "fibril-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run assets:build && npm run demo:build && astro dev",
    "build": "npm run assets:build && npm run demo:build && npm run demo:test && npm run story:test && npm run nav:check && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "smoke:server": "node scripts/smoke-server.mjs",
    "verify": "npm run build && npm run smoke:dist",
    "story:test": "npm run story:check && node scripts/broker-story.test.mjs",
    "demo:build": "node demo/build.mjs",
    "demo:test": "node demo/demo.test.mjs && node ../crates/admin/tests/settings-form.test.mjs && node ../crates/admin/tests/recovery-timeline.test.mjs && node ../crates/admin/tests/page-lifecycle.test.mjs",
    "assets:build": "node scripts/build-branding.mjs",
    "story:check": "tsc --project tsconfig.stories.json",
    "nav:check": "node scripts/check-navigation.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.3",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.3",
    "starlight-versions": "^0.9.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  }
}
